# 이 파일을 .env.local 로 복사해서 값을 채운다. .env.local은 git에 올라가지 않는다.
# Vercel에는 같은 이름으로 Project Settings → Environment Variables에 넣는다.

# --- DB (Neon) --- 없으면 로컬 PGlite(.pglite/)를 쓴다. 배포에서는 필수.
DATABASE_URL=

# --- 로그인 ---
# 앱에 들어갈 때 쓰는 비밀번호
APP_PASSWORD=
# 로그인 쿠키 서명 키 (선택, 없으면 APP_PASSWORD 사용). 만들기: openssl rand -base64 32
SESSION_SECRET=

# --- cron ---
# Vercel Cron / GitHub Actions가 "Authorization: Bearer <값>"으로 보낸다. 만들기: openssl rand -base64 32
CRON_SECRET=

# --- 앱 주소 (캘린더 이벤트 설명에 앱 링크를 넣을 때) ---
APP_URL=https://your-app.vercel.app

# --- 구글 캘린더 (docs/infra/03-google.md) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 선택: 기본은 <요청 주소>/api/google/callback
GOOGLE_REDIRECT_URI=
# 선택: 바쁜 시간을 읽을 캘린더를 더 추가 (쉼표로 구분, 기본은 primary)
GOOGLE_BUSY_CALENDARS=

# --- 웹 푸시 (docs/infra/04-push.md) --- 만들기: pnpm exec web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Claude (공고 추출, 이후 작업) ---
ANTHROPIC_API_KEY=

# --- justdo 연동 (docs/infra/05-justdo.md) --- 서류 접수 기간을 justdo 할 일로 보낸다. 없으면 건너뜀.
# 예: https://www.justdo.co.kr
JUSTDO_API_URL=
# justdo에서 발급한 연동 토큰 (jd_int_...)
JUSTDO_API_TOKEN=
