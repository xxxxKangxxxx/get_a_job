# `pnpm first-setup`이 이 파일을 .env.local로 복사하고 비밀값을 채운다. .env.local은 git에 올라가지 않는다.
# 배포(Vercel)에는 같은 이름으로 Project Settings → Environment Variables에 넣는다.

# ===== 필수 =====

# DB (Neon). 비워 두면 로컬 개발용 PGlite(.pglite/)를 쓴다. 배포에서는 필수.
DATABASE_URL=
# 앱에 들어갈 때 쓰는 비밀번호
APP_PASSWORD=
# 로그인 쿠키 서명 키. 만들기: openssl rand -base64 32
SESSION_SECRET=
# 매일 아침 작업(cron) 인증. Vercel Cron이 "Authorization: Bearer <값>"으로 보낸다.
CRON_SECRET=

# ===== 내 데이터 (선택, 기본값이 있음) =====

# 공고·지원현황 원본 JSON (기본 data/postings.json)
POSTINGS_JSON=
# 내 조건 파일 (기본 data/profile.md)
PROFILE_MD=
# 개인정보처리방침(/privacy)에 보일 연락처. 구글 캘린더 연동을 쓰면 필요
CONTACT_EMAIL=
# 앱 주소. 캘린더 일정 설명에 앱 링크를 넣을 때 (예: https://my-get-a-job.vercel.app)
APP_URL=

# ===== 선택 기능: 웹 푸시 알림 (docs/setup/push.md) =====
# first-setup이 만들어 준다. 직접 만들기: pnpm exec web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# ===== 선택 기능: 구글 캘린더 (docs/setup/google.md) =====
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 기본은 <요청 주소>/api/google/callback
GOOGLE_REDIRECT_URI=
# 바쁜 시간을 읽을 캘린더를 더 추가 (쉼표로 구분, 기본은 primary)
GOOGLE_BUSY_CALENDARS=

# ===== 선택 기능: justdo 연동 (docs/setup/justdo.md) =====
# 서류 접수 기간을 justdo 할 일로 보낸다. 둘 다 있어야 동작한다.
JUSTDO_API_URL=https://www.justdo.co.kr
JUSTDO_API_TOKEN=
